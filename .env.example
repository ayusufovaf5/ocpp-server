# WARNING: defaults below are for LOCAL DEVELOPMENT ONLY.
# Do not use these DB passwords or API_KEY outside local/dev environments.

API_HOST=0.0.0.0
API_PORT=8000
OCPP16_PORT=9000
LOG_LEVEL=INFO
# console = readable local logs; json = structured (prod/CI)
LOG_FORMAT=console

PG_HOST=localhost
PG_PORT=5432
PG_USER=opencpo
PG_PASSWORD=ocpp123
PG_DATABASE=opencpo
# DATABASE_URL=postgresql+asyncpg://opencpo:ocpp123@localhost:5432/opencpo

REDIS_URL=redis://localhost:6379/0
REDIS_STATE_TTL_SECONDS=86400

# REST auth (header X-API-Key). Change before any shared/staging/prod use.
API_KEY=dev-api-key-change-me

# OCPP WS allowlist: comma-separated charge_point_id values, or * for any (dev only).
OCPP_CHARGE_POINT_ALLOWLIST=*

OCPP_HEARTBEAT_INTERVAL=60
HEARTBEAT_TIMEOUT_SECONDS=120
HEARTBEAT_CHECK_INTERVAL_SECONDS=30
OFFLINE_SESSION_GRACE_PERIOD_SECONDS=300
